# 复制为 .env 后按需修改，docker compose 会自动读取
MINITREK_ADMIN_PASSWORD=changeme
# MCP Token（可选：也可在 Web 首页「AI 规划」或设置页点「生成新 Token」在线生成，页面生成的存数据库哈希）
MINITREK_MCP_TOKEN=changeme
# 高德 Key（可选，也可进设置页填；JS Key 用于地图，Web 服务 Key 用于地点搜索/定位）
AMAP_KEY=
AMAP_WEB_KEY=
# 12306 车票查询 MCP 服务地址（本地开发默认本机 9999；compose 部署自动指向 12306-mcp 服务）
MINITREK_12306_MCP_URL=http://127.0.0.1:9999/mcp
