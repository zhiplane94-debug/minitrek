{
  "name": "minitrek-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "miniTrek 后端：REST API + 数据层（SQLite/Drizzle）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
